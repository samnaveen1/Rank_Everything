{
  "expo": {
    "name": "RANK.io",
    "slug": "samnaveen",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rankeverything",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.samnaveen27steam.samnaveen"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F9FF",
          "dark": {
            "backgroundColor": "#EAF1FF"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "RANK.io uses your photos so you can attach posters to the things you rank.",
          "cameraPermission": "RANK.io uses your camera so you can photograph posters for the things you rank.",
          "microphonePermission": false,
          "colors": {
            "cropToolbarColor": "#2864F0"
          },
          "dark": {
            "colors": {
              "cropToolbarColor": "#1746D1"
            }
          }
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6ce28df6-05db-4ad0-b9d2-0783fb662f7d"
      }
    },
    "owner": "samnaveen27s-team"
  }
}
