# Web: http://localhost:4000
# Android emulator: http://10.0.2.2:4000
# Physical Android device: use your computer LAN IP, for example http://192.168.1.20:4000
EXPO_PUBLIC_API_URL=http://localhost:4000
# Google OAuth Web application client ID. Leave empty to disable the
# "Continue with Google" button (it will say sign-in is not configured).
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
